function bqrefresh {
	cd ~/code/dotnet/issuing/gcp-dbt-issuing/gcp-dbt-issuing-payments
	# Execute the deployment macros first
	# dbt run-operation deploy_adjust_settlement_date_using_cycle_number --target ci
	# dbt run-operation deploy_adjust_settlement_date_using_cycle_number_with_settlement_holidays --target ci
	# dbt run-operation deploy_adjust_settlement_date_using_date --target ci
	# Then run the models
	dbt run --full-refresh --target local --show-all-deprecations
}

function bqincrefresh {
	cd ~/code/dotnet/issuing/gcp-dbt-issuing/gcp-dbt-issuing-payments
	# Execute the deployment macros first
	dbt run-operation deploy_adjust_settlement_date_using_cycle_number --target local
	dbt run-operation deploy_adjust_settlement_date_using_cycle_number_with_settlement_holidays --target local
	dbt run-operation deploy_adjust_settlement_date_using_date --target local
	# Then run the models
	dbt run --target local --show-all-deprecations
}